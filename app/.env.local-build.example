# Git-ignored (.gitignore covers *.env and .env*). Read by ./build-local.sh.
#
# The tailnet name rather than a LAN address: it resolves both at home and
# away, so one build works everywhere Tailscale is on. A LAN address only
# works on that LAN, which is why the previous build stopped at the door.
OMI_DEV_HOST=YOUR-HOST.your-tailnet.ts.net
OMI_LOCAL_API_BASE_URL=https://YOUR-HOST.your-tailnet.ts.net/
OMI_MOBILE_BUILD_MODE=profile
